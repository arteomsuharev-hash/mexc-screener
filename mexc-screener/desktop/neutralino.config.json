{
  "applicationId": "com.mexcscreener.app",
  "version": "1.7.1",
  "defaultMode": "window",
  "port": 38217,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "none",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "events.*",
    "filesystem.*",
    "storage.*",
    "net.*"
  ],
  "modes": {
    "window": {
      "title": "Vision Screener",
      "width": 1600,
      "height": 950,
      "minWidth": 1100,
      "minHeight": 650,
      "icon": "/resources/icon.png",
      "enableInspector": true,
      "borderless": false
    }
  },
  "cli": {
    "binaryName": "mexc-screener",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}